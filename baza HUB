local function SetupPlayerOutline(player)
    if player == LocalPlayer then return end
    local hl = Instance.new("Highlight")
    hl.Name = "BazaPlayerHL_" .. player.Name
    hl.Parent = EspFolder
    CheatState.outlineObjects[player] = hl
    if player.Character then UpdateOutline(player, player.Character) end
end

local function RemovePlayerEsp(player)
    if CheatState.espObjects[player] then pcall(function() CheatState.espObjects[player].billboard:Destroy() end) CheatState.espObjects[player] = nil end
    if CheatState.outlineObjects[player] then pcall(function() CheatState.outlineObjects[player]:Destroy() end) CheatState.outlineObjects[player] = nil end
    CheatState.playerRoles[player] = nil
    if CheatState.playerTeamConns[player] then pcall(function() CheatState.playerTeamConns[player]:Disconnect() end) CheatState.playerTeamConns[player] = nil end
end

local function UpdatePlayerEsp()
    for player, espObj in pairs(CheatState.espObjects) do
        if espObj and typeof(espObj) == "table" and espObj.billboard and espObj.billboard.Parent then
            local role = GetPlayerRole(player)
            local isKiller = (role == "killer")
