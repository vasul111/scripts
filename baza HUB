-- PLAYER ESP & HIGHLIGHTS
-- =======================================================
local function CreateHighlight(obj, color, fillTrans)
    if not obj or not obj.Parent then return end
    local highlight = obj:FindFirstChild("BazaHL")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "BazaHL"
        highlight.Adornee = obj
        highlight.FillTransparency = fillTrans or 0.6
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.Parent = obj
        return
    end
    if highlight.FillColor ~= color then
        highlight.FillColor = color
        highlight.OutlineColor = color
    end
    highlight.FillTransparency = fillTrans or 0.6
    highlight.Enabled = true
end

local function RemoveHighlight(obj)
    if not obj then return end
    local hl = obj:FindFirstChild("BazaHL")
    if hl then pcall(function() hl:Destroy() end) end
end

local function UpdateOutline(player, character)
    local hl = CheatState.outlineObjects[player]
    if not hl then return end
    local role = GetPlayerRole(player)
    local isKiller = (role == "killer")
    local color = isKiller and Config.killerColor or Config.survivorColor
    local showOutline = isKiller and Config.killerShowOutline or Config.survivorShowOutline
    local outlineOnly = isKiller and Config.killerOutlineOnly or Config.survivorOutlineOnly
    local enabled = isKiller and Config.espKiller or Config.espSurvivors

    hl.Adornee = character
    hl.FillColor = color
    hl.OutlineColor = color
    hl.FillTransparency = outlineOnly and 1 or Config.fillTransparency
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = enabled and showOutline
end

local function AttachEspAdornee(player, character)
    local espObj = CheatState.espObjects[player]
    if not espObj or not espObj.billboard then return end
    local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
    if root then espObj.billboard.Adornee = root end
    local role = GetPlayerRole(player)
    local isKiller = (role == "killer")
    local enabled = isKiller and Config.espKiller or Config.espSurvivors
    local showName = isKiller and Config.killerShowName or Config.survivorShowName

    espObj.nameLabel.Visible = enabled and showName
    espObj.nameLabel.Text = player.Name
end

local function SetupPlayerEsp(player)
    if player == LocalPlayer then return end
    UpdatePlayerRole(player)
    local role = GetPlayerRole(player)
    local isKiller = (role == "killer")

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "BazaESP_BB_" .. player.Name
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 150, 0, 18)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
