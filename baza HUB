local function TriggerSkillCheckHit()
    local button = GetActionButton()
    if button then
        if type(firesignal) == "function" then
            local success = pcall(function()
                firesignal(button.MouseButton1Down)
                task.delay(0.05, function()
                    if button and button.Parent then
                        firesignal(button.MouseButton1Up)
                        firesignal(button.MouseButton1Click)
                    end
                end)
            end)
            if success then return end
        end
        pcall(function()
            local x = button.AbsolutePosition.X + button.AbsoluteSize.X / 2
            local y = button.AbsolutePosition.Y + button.AbsoluteSize.Y / 2
            VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
            task.delay(0.05, function()
                VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
            end)
        end)
        return
    end
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
    task.wait()
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
end

local instantLastVisible = false
local lastGoalRot = nil
local lastPressTime = 0

local function HandleAutoGenerators()
    if not Config.autoGenerator then return end
    local lineObject, goalObject = GetSkillCheckObjects()
    if not lineObject or not goalObject then
        instantLastVisible = false
        lastGoalRot = nil
        return
    end

    local goalRotation = goalObject.Rotation
    local lineRotation = lineObject.Rotation
    local currentTime = tick()

    if Config.autoGeneratorMode == "Instant" then
        local instantRotation = goalRotation + 109
        lineObject.Rotation = instantRotation
        if not instantLastVisible or goalRotation ~= lastGoalRot then
            if currentTime - lastPressTime > 0.05 then
                lastGoalRot = goalRotation
                instantLastVisible = true
                lastPressTime = currentTime
                TriggerSkillCheckHit()
            end
        end
    elseif Config.autoGeneratorMode == "Perfect" then
        local diff = (lineRotation - goalRotation) % 360
        if currentTime - lastPressTime > 0.15 then
            if diff >= 102 and diff <= 109 then
                lastPressTime = currentTime
                TriggerSkillCheckHit()
            end
        end
    else
        local diff = (lineRotation - goalRotation) % 360
        if currentTime - lastPressTime > 0.15 then
            if diff >= 125 and diff <= 140 then
                lastPressTime = currentTime
                TriggerSkillCheckHit()
            end
        end
    end
end

