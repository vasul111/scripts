            espObj.nameLabel.Visible = enabled and (isKiller and Config.killerShowName or Config.survivorShowName)
            espObj.billboard.MaxDistance = Config.maxDistance
        end
    end
    for player, hl in pairs(CheatState.outlineObjects) do
        if hl and hl.Parent and player and player.Parent and player.Character then UpdateOutline(player, player.Character) end
    end
end

local function OnPlayerSetup(player, character)
    if player == LocalPlayer then return end
    AttachEspAdornee(player, character)
    UpdateOutline(player, character)
    if Config.hitboxEnabled then task.wait(0.3) SetPlayerHitbox(player, character) end
    if Config.hitboxEspEnabled then SetupHitboxEsp(player, character) end
end

local function OnPlayerAdded(player)
    if player == LocalPlayer then return end
    UpdatePlayerRole(player)
    SetupPlayerEsp(player)
    SetupPlayerOutline(player)

    if player.Character then task.spawn(function() OnPlayerSetup(player, player.Character) end) end
    player.CharacterAdded:Connect(function(character) task.spawn(function() OnPlayerSetup(player, character) end) end)
end

