local function UpdateGeneratorEsp(gen)
    if not gen or not gen.Parent then return true end
    if CheatState.completedGenerators[gen] then return true end

    local progress = GetAttributeOrValue(gen, "RepairProgress") or GetAttributeOrValue(gen, "Progress") or 0
    local isCompleted = (progress >= 100) or (GetAttributeOrValue(gen, "Completed") == true) or (GetAttributeOrValue(gen, "IsCompleted") == true) or (GetAttributeOrValue(gen, "Done") == true)

    local billboard = gen:FindFirstChild("BazaGenProgress")

    if isCompleted or not Config.espGeneratorEnabled then
        if billboard then billboard:Destroy() end
        RemoveHighlight(gen)
        gen:SetAttribute("BazaGenLastPct", nil)
        if isCompleted then CheatState.completedGenerators[gen] = true end
        return isCompleted
    end

    CreateHighlight(gen, Config.espGeneratorColor, 0.6)

    if Config.espGeneratorProgressGen then
        local pct = math.floor(progress + 0.5)
        local lastPct = gen:GetAttribute("BazaGenLastPct")
        if lastPct == pct and billboard then return false end
        gen:SetAttribute("BazaGenLastPct", pct)

        local clampedPct = math.clamp(progress, 0, 100)
        local color = (clampedPct < 50)
            and Config.espGeneratorColor:Lerp(Color3.fromRGB(255, 200, 0), clampedPct / 50)
            or Color3.fromRGB(255, 200, 0):Lerp(Color3.fromRGB(100, 255, 80), (clampedPct - 50) / 50)

        local textStr = string.format("%d%%", pct)
        local mainPart = gen:FindFirstChild("defaultMaterial", true) or (gen:IsA("Model") and gen.PrimaryPart) or gen:FindFirstChildWhichIsA("BasePart", true)

        if not mainPart then return false end

        if not billboard then
            billboard = Instance.new("BillboardGui")
            billboard.Name = "BazaGenProgress"
            billboard.Adornee = mainPart
            billboard.AlwaysOnTop = true
            billboard.LightInfluence = 0
            billboard.ResetOnSpawn = false
            billboard.MaxDistance = 260
            billboard.Size = UDim2.new(0, 160, 0, 36)
            billboard.StudsOffset = Vector3.new(0, 1.95, 0)
            billboard.Parent = gen

            local label = Instance.new("TextLabel")
            label.Name = "Label"
            label.BackgroundTransparency = 1
            label.Size = UDim2.fromScale(1, 1)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 16
            label.Text = textStr
            label.TextColor3 = color
            label.TextStrokeTransparency = 0
            label.Parent = billboard

            local stroke = Instance.new("UIStroke")
            stroke.Thickness = 1.5
            stroke.Transparency = 0.15
            stroke.Color = Color3.new(0, 0, 0)
            stroke.Parent = label
        else
            local label = billboard:FindFirstChild("Label")
            if label then label.Text = textStr label.TextColor3 = color end
        end
    else
        if billboard then billboard:Destroy() gen:SetAttribute("BazaGenLastPct", nil) end
    end
    return false
end

local function MonitorGeneratorProgress(gen)
    local function update() if not Config.espGeneratorEnabled then return end UpdateGeneratorEsp(gen) end
    pcall(function()
        gen:GetAttributeChangedSignal("RepairProgress"):Connect(update)
        gen:GetAttributeChangedSignal("Progress"):Connect(update)
        gen:GetAttributeChangedSignal("Completed"):Connect(update)
        gen:GetAttributeChangedSignal("IsCompleted"):Connect(update)
    end)
    gen.ChildAdded:Connect(function(child)
        if child.Name == "RepairProgress" or child.Name == "Progress" or child.Name == "Completed" or child.Name == "IsCompleted" then
            if child:IsA("ValueBase") then child.Changed:Connect(update) end
            update()
        end
    end)
end

local function MonitorPalletState(pallet, meta)
    local function update()
        local dropped = GetAttributeOrValue(pallet, "Dropped") or GetAttributeOrValue(pallet, "IsDropped")
        local broken = GetAttributeOrValue(pallet, "Broken") or GetAttributeOrValue(pallet, "IsBroken") or GetAttributeOrValue(pallet, "Destroyed")
        if dropped or broken or meta.isFake then
            RemoveHighlight(pallet)
            for i, p in ipairs(CheatState.cachedMapObjects.Pallets) do
                if p == pallet then table.remove(CheatState.cachedMapObjects.Pallets, i) break end
            end
            CheatState.cachedPalletMeta[pallet] = nil
        end
    end
    for _, attrName in ipairs({"Dropped", "IsDropped", "Broken", "IsBroken", "Destroyed"}) do
        pallet:GetAttributeChangedSignal(attrName):Connect(update)
    end
end

local function OnMapObjectAdded(obj)
    local name = obj.Name
    if name == "Generator" then
        table.insert(CheatState.cachedMapObjects.Generators, obj)
        if Config.espGeneratorEnabled then UpdateGeneratorEsp(obj) MonitorGeneratorProgress(obj) end
    elseif name == "Hook" then
        table.insert(CheatState.cachedMapObjects.Hooks, obj)
        local meshParts = {}
        local model = obj:FindFirstChild("Model")
        if model then
            for _, child in ipairs(model:GetDescendants()) do if child:IsA("MeshPart") then table.insert(meshParts, child) end end
        end
        CheatState.cachedHookMeshParts[obj] = meshParts
        if Config.espHookEnabled then
            if #meshParts > 0 then for _, mp in ipairs(meshParts) do CreateHighlight(mp, Config.espHookColor, 0.6) end
            else CreateHighlight(obj, Config.espHookColor, 0.6) end
        end
    elseif name == "Gate" then
        table.insert(CheatState.cachedMapObjects.Gates, obj)
        if Config.espGateEnabled then CreateHighlight(obj, Config.espGateColor, 0.6) end
        if CheatState.ghostGateEnabled then Hub.ApplyGhostGateToObj(obj, true) end
    elseif name == "Pallet" or name == "Palletwrong" then
        table.insert(CheatState.cachedMapObjects.Pallets, obj)
        local lowerName = name:lower()
        local part = (obj:IsA("Model") and obj.PrimaryPart) or obj:FindFirstChildWhichIsA("BasePart", true) or (obj:IsA("BasePart") and obj)
        local isFake = lowerName:find("fake") or lowerName:find("broken") or lowerName:find("destroyed")
        local meta = {part = part, isFake = isFake and true or false}
        CheatState.cachedPalletMeta[obj] = meta
        if Config.espPalletEnabled and not meta.isFake then CreateHighlight(obj, Config.espPalletColor, 0.6) end
        MonitorPalletState(obj, meta)
    end
end

local function OnMapObjectRemoved(obj)
    local name = obj.Name
    if name == "Generator" then
        for i, g in ipairs(CheatState.cachedMapObjects.Generators) do if g == obj then table.remove(CheatState.cachedMapObjects.Generators, i) break end end
        CheatState.completedGenerators[obj] = nil
        RemoveHighlight(obj)
        local bb = obj:FindFirstChild("BazaGenProgress") if bb then bb:Destroy() end
    elseif name == "Hook" then
        for i, h in ipairs(CheatState.cachedMapObjects.Hooks) do if h == obj then table.remove(CheatState.cachedMapObjects.Hooks, i) break end end
        local meshParts = CheatState.cachedHookMeshParts[obj]
        if meshParts then for _, mp in ipairs(meshParts) do RemoveHighlight(mp) end else RemoveHighlight(obj) end
        CheatState.cachedHookMeshParts[obj] = nil
    elseif name == "Gate" then
        for i, g in ipairs(CheatState.cachedMapObjects.Gates) do if g == obj then table.remove(CheatState.cachedMapObjects.Gates, i) break end end
        RemoveHighlight(obj)
    elseif name == "Pallet" or name == "Palletwrong" then
        for i, p in ipairs(CheatState.cachedMapObjects.Pallets) do if p == obj then table.remove(CheatState.cachedMapObjects.Pallets, i) break end end
        RemoveHighlight(obj)
        CheatState.cachedPalletMeta[obj] = nil
    end
end

local function ScanMapObjects(mapFolder)
    if not mapFolder then return end
    CheatState.cachedMapObjects = {Generators = {}, Pallets = {}, Hooks = {}, Gates = {}}
    CheatState.cachedPalletMeta = {}
    CheatState.cachedHookMeshParts = {}
    CheatState.completedGenerators = {}
    for _, descendant in ipairs(mapFolder:GetDescendants()) do OnMapObjectAdded(descendant) end
end

local function InitializeMapEsp(mapFolder)
    if not mapFolder then return end
    ScanMapObjects(mapFolder)
    mapFolder.DescendantAdded:Connect(OnMapObjectAdded)
    mapFolder.DescendantRemoving:Connect(OnMapObjectRemoved)
    CheatState.objEspInitialized = true
end

local mapObj = Workspace:FindFirstChild("Map")
if mapObj then InitializeMapEsp(mapObj) end

Workspace.ChildAdded:Connect(function(child)
    if child.Name == "Map" then task.wait(2) InitializeMapEsp(child) end
end)

Workspace.ChildRemoved:Connect(function(child)
    if child.Name == "Map" then
        CheatState.cachedMapObjects = {Generators = {}, Pallets = {}, Hooks = {}, Gates = {}}
        CheatState.cachedPalletMeta = {}
        CheatState.cachedHookMeshParts = {}
        CheatState.completedGenerators = {}
        CheatState.objEspInitialized = false
    end
end)

local function UpdateMapEsp()
    if not CheatState.objEspInitialized then return end
    if Config.espGeneratorEnabled then
        local validGens = {}
        for _, gen in ipairs(CheatState.cachedMapObjects.Generators) do
            if gen and gen.Parent then
                local done = UpdateGeneratorEsp(gen)
                if not done then table.insert(validGens, gen) end
            end
        end
        CheatState.cachedMapObjects.Generators = validGens
    else
        for _, gen in ipairs(CheatState.cachedMapObjects.Generators) do
            if gen and gen.Parent then
                RemoveHighlight(gen)
                local bb = gen:FindFirstChild("BazaGenProgress") if bb then bb:Destroy() end
                gen:SetAttribute("BazaGenLastPct", nil)
            end
        end
    end

    if Config.espPalletEnabled then
        for _, pallet in ipairs(CheatState.cachedMapObjects.Pallets) do
            if pallet and pallet.Parent then
                local meta = CheatState.cachedPalletMeta[pallet]
                if meta and not meta.isFake then CreateHighlight(pallet, Config.espPalletColor, 0.6) end
            end
        end
    else
        for _, pallet in ipairs(CheatState.cachedMapObjects.Pallets) do if pallet then RemoveHighlight(pallet) end end
    end

    if Config.espHookEnabled then
        for _, hook in ipairs(CheatState.cachedMapObjects.Hooks) do
            if hook and hook.Parent then
                local meshParts = CheatState.cachedHookMeshParts[hook]
                if meshParts and #meshParts > 0 then for _, mp in ipairs(meshParts) do CreateHighlight(mp, Config.espHookColor, 0.6) end
                else CreateHighlight(hook, Config.espHookColor, 0.6) end
            end
        end
    else
        for _, hook in ipairs(CheatState.cachedMapObjects.Hooks) do
            if hook and hook.Parent then
                local meshParts = CheatState.cachedHookMeshParts[hook]
                if meshParts then for _, mp in ipairs(meshParts) do RemoveHighlight(mp) end else RemoveHighlight(hook) end
            end
        end
    end

    if Config.espGateEnabled then
        for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do if gate and gate.Parent then CreateHighlight(gate, Config.espGateColor, 0.6) end end
    else
        for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do if gate and gate.Parent then RemoveHighlight(gate) end end
    end
end

