local function EnableSkipEndScreen()
    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Game")
        if remotes then
            for _, name in ipairs({"cutscene", "cutsceneEnd", "endscreencutscene"}) do
                local r = remotes:FindFirstChild(name)
                if r and r:IsA("RemoteEvent") and type(getconnections) == "function" then
                    pcall(function()
                        for _, conn in ipairs(getconnections(r.OnClientEvent)) do
                            pcall(function() conn:Disable() end)
                            pcall(function() conn:Disconnect() end)
                        end
                    end)
                end
            end
        end
    end)
    table.insert(CheatState.skipEndScreenConns, RunService.Heartbeat:Connect(function()
        if LocalPlayer:GetAttribute("isspectating") then LocalPlayer:SetAttribute("isspectating", false) end
        if LocalPlayer:GetAttribute("killerend") then LocalPlayer:SetAttribute("killerend", false) end
    end))
end

local function DisableSkipEndScreen()
