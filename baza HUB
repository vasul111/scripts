local function GetPlayerRole(player)
    return CheatState.playerRoles[player] or "survivor"
end

local function UpdatePlayerRole(player)
    local success, teamName = pcall(function()
        return player.Team and player.Team.Name:lower() or ""
    end)
    CheatState.playerRoles[player] = (success and teamName:find("killer")) and "killer" or "survivor"
end

local function GetAttributeOrValue(obj, name)
    if typeof(obj) ~= "Instance" then return nil end
    local attr = obj:GetAttribute(name)
    if attr ~= nil then return attr end
    local child = obj:FindFirstChild(name)
    if child and child:IsA("ValueBase") then return child.Value end
    return nil
end

local validPartNames = {
    "HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso",
    "LeftArm", "RightArm", "LeftLeg", "RightLeg",
    "Left UpperArm", "Left LowerArm", "Left Hand",
    "Right UpperArm", "Right LowerArm", "Right Hand",
    "Left UpperLeg", "Left LowerLeg", "Left Foot",
    "Right UpperLeg", "Right LowerLeg", "Right Foot"
}

local function GetCharacterParts(character)
    local parts = {}
    for _, child in ipairs(character:GetDescendants()) do
        if child:IsA("BasePart") and not isFlag_1[child.Name] and table.find(validPartNames, child.Name) then
            table.insert(parts, child)
        end
    end
    return parts
end

