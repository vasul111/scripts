local function SetPlayerHitbox(player, character)
    if not Config.hitboxEnabled then return end
    local parts = GetCharacterParts(character)
    local role = GetPlayerRole(player)
    local sizeMultiplier = (role == "killer") and Config.killerHitboxSize or Config.survivorHitboxSize
    local multiplier = sizeMultiplier / 100

    for _, part in ipairs(parts) do
        if not CheatState.hitboxOriginalSizes[part] then CheatState.hitboxOriginalSizes[part] = part.Size end
        pcall(function() part.Size = CheatState.hitboxOriginalSizes[part] * multiplier end)
    end
end

local function ResetPlayerHitbox(player, character)
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            local orig = CheatState.hitboxOriginalSizes[part]
            if orig then pcall(function() part.Size = orig end) CheatState.hitboxOriginalSizes[part] = nil end
        end
    end
end

local function SetAllHitboxes()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if Config.hitboxEnabled then SetPlayerHitbox(player, player.Character) else ResetPlayerHitbox(player, player.Character) end
        end
    end
end

local function SetupHitboxEsp(player, character)
    if player == LocalPlayer then return end
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    local role = GetPlayerRole(player)
    local color = (role == "killer") and Config.hitboxEspKillerColor or Config.hitboxEspSurvivorColor

    local box = CheatState.hitboxEspObjects[player]
    if not box or not box.Parent then
        box = Instance.new("SelectionBox")
        box.Name = "BazaHitboxBox"
        box.Adornee = rootPart
        box.LineThickness = 0.05
        box.Parent = EspFolder
        CheatState.hitboxEspObjects[player] = box
    end
    box.Color3 = color
    box.SurfaceColor3 = color
    box.SurfaceTransparency = Config.hitboxEspOutlineOnly and 1 or Config.hitboxEspTransparency
end

local function RemoveHitboxEsp(player)
    local box = CheatState.hitboxEspObjects[player]
    if box then pcall(function() box:Destroy() end) CheatState.hitboxEspObjects[player] = nil end
end

-- =======================================================
-- KILLER PROXIMITY WARNING
-- =======================================================
local function CheckKillerProximity()
    if not Config.warnEnabled then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local nearestDist = math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and GetPlayerRole(player) == "killer" then
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist < nearestDist then nearestDist = dist end
            end
        end
    end

    if nearestDist <= Config.warnDist3 and CheatState.lastWarnLevel ~= 3 then
        CheatState.lastWarnLevel = 3
        BazaUI:MakeNotify({ Title = "KILLER NEARBY", Description = "WARNING", Content = "KILLER VERY CLOSE! (" .. math.floor(nearestDist) .. "m)", Color = Color3.fromRGB(255, 30, 30), Delay = 3 })
    elseif nearestDist <= Config.warnDist2 and nearestDist > Config.warnDist3 and CheatState.lastWarnLevel ~= 2 then
        CheatState.lastWarnLevel = 2
        BazaUI:MakeNotify({ Title = "KILLER APPROACHING", Description = "WARNING", Content = "Killer approaching (" .. math.floor(nearestDist) .. "m)", Color = Color3.fromRGB(255, 150, 0), Delay = 3 })
    elseif nearestDist <= Config.warnDist1 and nearestDist > Config.warnDist2 and CheatState.lastWarnLevel ~= 1 then
        CheatState.lastWarnLevel = 1
        BazaUI:MakeNotify({ Title = "KILLER SPOTTED", Description = "WARNING", Content = "Killer spotted (" .. math.floor(nearestDist) .. "m)", Color = Color3.fromRGB(255, 220, 0), Delay = 3 })
    elseif nearestDist > Config.warnDist1 then
        CheatState.lastWarnLevel = 0
    end
end

