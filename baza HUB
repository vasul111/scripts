local AutoParryState = {
    Enabled = false, Cooldown = false, COOLDOWN_TIME = 1.0, KillerConns = {},
    EspPart = nil, EspFolder = nil, DaggerWaitConns = {}, HOLD_TIME = 0.06,
    MOB_TIMEOUT = 120, CTRL_TIMEOUT = 30, BTN_TIMEOUT = 30, RIGHT_MOUSE = 1,
    CachedBtn = nil, WaitingForBtn = false, KillerBlacklist = {}, BLACKLIST_DURATION = 2.5
}
local parryDaggerName = "Parrying Dagger"
local killerAnims = {"lungehold", "lungeholdcobra", "attack", "attackfr", "attackcobra", "attacktony"}

local function HasParryDagger()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack and backpack:FindFirstChild(parryDaggerName) then return true end
    local char = LocalPlayer.Character
    if char and char:FindFirstChild(parryDaggerName) then return true end
    return false
end

local function IsAnimationMatching(track)
    local anim = track.Animation
    if not anim then return false end
    local name = anim.Name
    if name then
        local lowerName = name:lower():gsub("%s+", "")
        for _, kName in ipairs(killerAnims) do
            if lowerName == kName then return true end
        end
    end
    return false
end

function Hub.IsPlayerInParryRange(killerChar)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not killerRoot then return false end
    return (killerRoot.Position - myRoot.Position).Magnitude <= CheatState.autoParryRadius
end

function Hub.IsTargetFacingMe(killerChar)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not myRoot or not killerRoot then return false end
    local dir = (myRoot.Position - killerRoot.Position).Unit
    return killerRoot.CFrame.LookVector:Dot(dir) > 0.46
end

function Hub.GetParryButton()
    if AutoParryState.CachedBtn and AutoParryState.CachedBtn.Parent and AutoParryState.CachedBtn.Visible then
        return AutoParryState.CachedBtn
    end
    local survivorMob = PlayerGui:FindFirstChild("Survivor-mob")
    if not survivorMob then return nil end
    local controls = survivorMob:FindFirstChild("Controls")
    if not controls then return nil end
    local btn = controls:FindFirstChild("Gui-mob")
    if btn and btn:IsA("ImageButton") and btn.Visible then
        AutoParryState.CachedBtn = btn
        return btn
    end
    return nil
end

function Hub.TriggerParry()
    local btn = Hub.GetParryButton()
    if btn and type(firesignal) == "function" then
        firesignal(btn.MouseButton1Down)
        task.delay(AutoParryState.HOLD_TIME, function()
            if btn and btn.Parent then
                firesignal(btn.MouseButton1Up)
                firesignal(btn.MouseButton1Click)
            end
        end)
        return true
    end
    VirtualInputManager:SendMouseButtonEvent(0, 0, 1, true, game, 1)
    task.delay(AutoParryState.HOLD_TIME, function()
        VirtualInputManager:SendMouseButtonEvent(0, 0, 1, false, game, 1)
    end)
    return false
end

function Hub.ParryAttack(killerHum)
    if AutoParryState.Cooldown then return end
    AutoParryState.Cooldown = true
    if killerHum then AutoParryState.KillerBlacklist[killerHum] = tick() end
    Hub.TriggerParry()
    task.delay(AutoParryState.COOLDOWN_TIME, function()
        AutoParryState.Cooldown = false
    end)
end

function Hub.TrackKillerAnimations(player, char)
    if player == LocalPlayer then return end
    UpdatePlayerRole(player)
    if GetPlayerRole(player) ~= "killer" then return end
    char = char or player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or AutoParryState.KillerConns[hum] then return end

    local conn = hum.AnimationPlayed:Connect(function(track)
        if not CheatState.autoParryEnabled then return end
        if not IsAnimationMatching(track) then return end
        if not Hub.IsPlayerInParryRange(char) then return end
        if not Hub.IsTargetFacingMe(char) then return end

        local lastBl = AutoParryState.KillerBlacklist[hum]
        if lastBl and (tick() - lastBl) < AutoParryState.BLACKLIST_DURATION then return end
        Hub.ParryAttack(hum)
    end)
    AutoParryState.KillerConns[hum] = conn
end

function Hub.EnableAutoParry()
    CheatState.autoParryEnabled = true
    AutoParryState.Enabled = true
    for _, p in ipairs(Players:GetPlayers()) do Hub.TrackKillerAnimations(p) end
end

function Hub.DisableAutoParry()
    CheatState.autoParryEnabled = false
    AutoParryState.Enabled = false
    for _, conn in pairs(AutoParryState.KillerConns) do pcall(function() conn:Disconnect() end) end
    AutoParryState.KillerConns = {}
end

function Hub.ClearAutoParryEsp()
    if AutoParryState.EspFolder then pcall(function() AutoParryState.EspFolder:Destroy() end) AutoParryState.EspFolder = nil end
    for _, folder in ipairs(Workspace:GetChildren()) do
        if folder.Name == "AutoParryRadiusESP" then
            pcall(function() folder:Destroy() end)
        end
    end
    AutoParryState.EspPart = nil
end

function Hub.DrawAutoParryEsp()
    Hub.ClearAutoParryEsp()
    local folder = Instance.new("Folder")
    folder.Name = "AutoParryRadiusESP"
    folder.Parent = Workspace

    local centerPart = Instance.new("Part")
    centerPart.Name = "RadiusESP_Center"
    centerPart.Anchored = true
    centerPart.CanCollide = false
    centerPart.Transparency = 1
    centerPart.Size = Vector3.new(0.2, 0.2, 0.2)
    centerPart.Parent = folder

    local pointsCount = 36
    local radius = CheatState.autoParryRadius
    local attachments = {}

    for i = 1, pointsCount do
        local angle = (math.pi * 2 / pointsCount) * i
        local att = Instance.new("Attachment")
        att.Position = Vector3.new(math.cos(angle) * radius, -2.5, math.sin(angle) * radius)
        att.Parent = centerPart
        attachments[i] = att
    end

    for i = 1, pointsCount do
        local nextIdx = (i % pointsCount) + 1
        local beam = Instance.new("Beam")
        beam.Attachment0 = attachments[i]
        beam.Attachment1 = attachments[nextIdx]
        beam.Width0 = 0.15
        beam.Width1 = 0.15
        beam.Color = ColorSequence.new(Color3.fromRGB(255, 60, 60))
        beam.LightEmission = 1
        beam.FaceCamera = false
        beam.Parent = centerPart
    end

    AutoParryState.EspFolder = folder
    AutoParryState.EspPart = centerPart
end

task.spawn(function()
    while task.wait(0.1) do
        if CheatState.autoParryRadiusEsp then
            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and AutoParryState.EspPart and AutoParryState.EspPart.Parent then
                AutoParryState.EspPart.CFrame = CFrame.new(root.Position)
            end
        else
            if Workspace:FindFirstChild("AutoParryRadiusESP") or AutoParryState.EspPart ~= nil then
                Hub.ClearAutoParryEsp()
            end
        end
    end
end)

-- =======================================================
-- MOVEMENT MODIFICATION (NO SLOWDOWN & ANTI FALL SLOW)
-- =======================================================
local MovementConnections = {antiFall = nil, noSlow = nil}

local function GetModifiedWalkSpeed()
    if Config.speedBoost then
        return DefaultWalkSpeed * (1 + math.clamp(Config.boostPercent, 0, 100) / 100)
    end
    return DefaultWalkSpeed
end

local function EnableAntiFall(hum)
    if MovementConnections.antiFall then MovementConnections.antiFall:Disconnect() end
    if not hum then return end
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    MovementConnections.antiFall = hum.StateChanged:Connect(function(_, newState)
        if not Config.antiFallSlow then return end
        if newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.GettingUp or newState == Enum.HumanoidStateType.FallingDown then
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
                hum.WalkSpeed = GetModifiedWalkSpeed()
            end)
        end
    end)
end

local function DisableAntiFall(hum)
    if MovementConnections.antiFall then MovementConnections.antiFall:Disconnect() MovementConnections.antiFall = nil end
    if hum then pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true) end) end
end

local function EnableNoSlowdown(hum)
    if MovementConnections.noSlow then MovementConnections.noSlow:Disconnect() end
    if not hum or GetPlayerRole(LocalPlayer) == "killer" then return end
    MovementConnections.noSlow = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if not Config.noSlowdown or GetPlayerRole(LocalPlayer) == "killer" then return end
        local reqSpeed = GetModifiedWalkSpeed()
        if hum.WalkSpeed < reqSpeed - 0.05 then
            pcall(function() hum.WalkSpeed = reqSpeed end)
        end
    end)
end

local function DisableNoSlowdown()
    if MovementConnections.noSlow then MovementConnections.noSlow:Disconnect() MovementConnections.noSlow = nil end
end

