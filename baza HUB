-- GHOST GATE & TELEPORT TO EXIT GATE (ОТ BOLONG HUB)
-- =======================================================
function Hub.ApplyGhostGateToObj(gateObj, enable)
    if not gateObj or not gateObj.Parent then return end
    local parts = gateObj:IsA("BasePart") and {gateObj} or gateObj:GetDescendants()
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            if enable then
                if not CheatState.ghostGateBackups[part] then
                    CheatState.ghostGateBackups[part] = {CanCollide = part.CanCollide, Transparency = part.Transparency}
                end
                part.CanCollide = false
                part.Transparency = 0.6
            else
                if CheatState.ghostGateBackups[part] then
                    part.CanCollide = CheatState.ghostGateBackups[part].CanCollide
                    part.Transparency = CheatState.ghostGateBackups[part].Transparency
                end
            end
        end
    end
end

function Hub.ApplyGhostGate()
    for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do
        Hub.ApplyGhostGateToObj(gate, CheatState.ghostGateEnabled)
    end
end

function Hub.TeleportToExitGate()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then
        BazaUI:MakeNotify({ Title = "Teleport", Description = "Teleport", Content = "Character not found!", Color = Color3.fromRGB(255, 80, 80), Delay = 2 })
        return
    end
    local nearestGatePart = nil
    local nearestDist = math.huge
    for _, gate in ipairs(CheatState.cachedMapObjects.Gates) do
        if gate and gate.Parent then
            local part = (gate:IsA("Model") and gate.PrimaryPart) or (gate:IsA("BasePart") and gate) or gate:FindFirstChildWhichIsA("BasePart", true)
            if part then
                local dist = (part.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearestGatePart = part
                end
            end
        end
    end
    if not nearestGatePart then
        BazaUI:MakeNotify({ Title = "Teleport", Description = "Teleport", Content = "No gates found on map!", Color = Color3.fromRGB(255, 80, 80), Delay = 2 })
        return
    end

    local gatePos = nearestGatePart.Position
    local delta = gatePos - root.Position
    local deltaHoriz = Vector3.new(delta.X, 0, delta.Z)
    local dir = (deltaHoriz.Magnitude > 0.1) and deltaHoriz.Unit or nearestGatePart.CFrame.LookVector

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {char, nearestGatePart.Parent}

    local targetPos = nil
    for _, offsetDist in ipairs({15, 20, 25, 10}) do
        local startRay = gatePos + (dir * offsetDist) + Vector3.new(0, 10, 0)
        local hit = Workspace:Raycast(startRay, Vector3.new(0, -30, 0), rayParams)
        if hit then
            local ceilingHit = Workspace:Raycast(hit.Position + Vector3.new(0, 5, 0), Vector3.new(0, 5, 0), rayParams)
            if not ceilingHit then
                targetPos = hit.Position + Vector3.new(0, 3, 0)
                break
            end
        end
    end

    if targetPos then
        pcall(function() root.CFrame = CFrame.new(targetPos) end)
    else
        pcall(function() root.CFrame = CFrame.new(gatePos + Vector3.new(0, 5, 0)) end)
    end
end

-- =======================================================
-- LOCK FOV, FULLBRIGHT & REMOVE VISUAL EFFECTS
-- =======================================================
local function SetFov(fovVal)
    local cam = Workspace.CurrentCamera
    if not cam then return end
    if CheatState.originalFOV == nil then CheatState.originalFOV = cam.FieldOfView end
    cam.FieldOfView = fovVal
end

local function ResetFov()
    local cam = Workspace.CurrentCamera
    if cam and CheatState.originalFOV then cam.FieldOfView = CheatState.originalFOV end
    CheatState.originalFOV = nil
end

local function EnableFullbright()
    Lighting.Ambient = Color3.fromRGB(178, 178, 178)
    Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)
    Lighting.GlobalShadows = false
    Lighting.FogStart = 9e9
    Lighting.FogEnd = 9e9
end

local function DisableFullbright()
    Lighting.Ambient = Color3.fromRGB(128, 128, 128)
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    Lighting.GlobalShadows = true
    Lighting.FogStart = 0
    Lighting.FogEnd = 1000
end

local function RemoveVisualEffects()
    CheatState.postEffectBackups = {}
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("PostEffect") or child:IsA("Clouds") or child:IsA("Atmosphere") or child:IsA("Sky") then
            CheatState.postEffectBackups[child] = {Enabled = child.Enabled, Parent = child.Parent}
            pcall(function()
                if child:IsA("Sky") then child.Parent = nil else child.Enabled = false end
            end)
        end
    end
end

local function RestoreVisualEffects()
    for child, meta in pairs(CheatState.postEffectBackups) do
        if child then
            pcall(function()
                if child:IsA("Sky") then child.Parent = meta.Parent else child.Enabled = meta.Enabled end
            end)
        end
    end
    CheatState.postEffectBackups = {}
end

