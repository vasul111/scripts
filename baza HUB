    if CheatState.godEnabled then task.wait(0.3) EnableGodMode() end
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        if Config.antiFallSlow then EnableAntiFall(hum) end
        if Config.noSlowdown then EnableNoSlowdown(hum) end
    end
end)

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then OnPlayerAdded(p) end
end

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end

    if Config.lockFovEnabled then Camera.FieldOfView = Config.customFovValue end
    HandleAutoGenerators()
end)

RunService.RenderStepped:Connect(function()
    if Config.hitboxEspEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then SetupHitboxEsp(player, player.Character) end
        end
    else
        for player in pairs(CheatState.hitboxEspObjects) do RemoveHitboxEsp(player) end
    end

    CheckKillerProximity()
end)

